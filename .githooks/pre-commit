#!/usr/bin/env bash
set -euo pipefail

git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.kts?$|^\.editorconfig$' || exit 0

# Checks the staged tree. mise doesn't trust the temporary copy, so its environment comes from the repository.
eval "$(mise env -s bash)"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"
cd "$tmp"
ktlint --relative
