#!/usr/bin/env bash
# Runs the release check on pushed branches that change the version. CI enforces it; this only warns early.
set -euo pipefail

zero=0000000000000000000000000000000000000000
status=0

check() {
    local tmp
    tmp=$(mktemp -d)
    git worktree add -q --detach "$tmp/src" "$1"
    "$tmp/src/scripts/check-release.sh" > /dev/null || status=1
    git worktree remove --force "$tmp/src"
    rm -rf "$tmp"
}

while read -r _ local_sha remote_ref remote_sha; do
    [[ $local_sha != "$zero" && $remote_ref == refs/heads/* ]] || continue
    if [[ $remote_sha == "$zero" ]] || ! git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
        remote_sha=$(git merge-base origin/main "$local_sha") || continue
    fi
    if git diff -U0 "$remote_sha" "$local_sha" -- app/build.gradle | grep -qE '^[+-] *version(Name|Code) '; then
        check "$local_sha"
    fi
done

(( ! status )) || { echo "Push blocked: the release check failed." >&2; exit 1; }
